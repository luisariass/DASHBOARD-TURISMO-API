# Imagen de la API en NestJS. Convive con Dockerfile (FastAPI) mientras dure la
# migración; cuando se corte, este archivo pasa a llamarse Dockerfile y el otro
# se elimina.

# --- Etapa de construcción ---
FROM node:20-alpine AS build
WORKDIR /app

# Corepack instala la version de pnpm fijada en el campo packageManager de
# package.json. Se actualiza corepack primero porque el que trae Node 20 no
# reconoce las firmas de las versiones nuevas de pnpm.
RUN npm install -g corepack@latest && corepack enable pnpm

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json nest-cli.json ./
COPY src ./src
RUN pnpm build

# Se reinstalan solo las dependencias de producción para no arrastrar el
# compilador de TypeScript ni el CLI de Nest a la imagen final. node-linker
# hoisted evita los enlaces simbólicos de pnpm, que no sobreviven al COPY
# hacia la etapa siguiente.
RUN pnpm install --frozen-lockfile --prod --config.node-linker=hoisted

# --- Etapa de producción ---
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./

# El puerto lo decide la variable PORT; 8001 por defecto para poder correr en
# paralelo con FastAPI en el 8000.
EXPOSE 8001
CMD ["node", "dist/main"]
