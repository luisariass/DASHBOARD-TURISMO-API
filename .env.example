# Copia este archivo a .env y rellena los valores. El .env real no se commitea.

# Cadena de conexión de MongoDB Atlas
MONGODB_URI="mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Nombres de las dos bases de datos que consume la API
MONGODB_DATABASE_FOURSQUARE="nombre_bd_foursquare"
MONGODB_DATABASE_GOOGLE="nombre_bd_google"

# Redis. Para ejecutar uvicorn en tu máquina usa localhost; dentro de Docker
# Compose el docker-compose.yml lo sobreescribe a redis://redis:6379.
REDIS_URL="redis://localhost:6379"

# Orígenes permitidos por CORS, en formato lista JSON
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# --- Solo para la versión NestJS ---
# Puerto de la API. 8001 por defecto para poder correr en paralelo con FastAPI,
# que ocupa el 8000 durante la migración.
PORT=8001

# Ponlo en false para desactivar el caché sin tocar Redis. Es obligatorio al
# comparar respuestas contra FastAPI: con caché de por medio el diff no es
# fiable, porque la versión Python tiene un bug en la clave.
CACHE_ENABLED=true

# Nombres de colección por proveedor. Los valores por defecto son los reales del
# cluster y normalmente no hace falta tocarlos. Se exponen porque no coinciden
# entre proveedores: la base de Google llama a sus sitios 'sities', no
# 'sities_clean', y asumir lo segundo es lo que dejaba el dashboard sin datos de
# Google. Ver docs/PARIDAD.md.
# FOURSQUARE_COLLECTION_CLEAN=sities_clean
# FOURSQUARE_COLLECTION_FULL=sities_full
# GOOGLE_COLLECTION_CLEAN=sities
# GOOGLE_COLLECTION_FULL=sities_full
