# Copia este archivo a .env y rellena los valores. El .env real no se commitea.

# Cadena de conexión de MongoDB Atlas
MONGODB_URI="mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Nombres de las dos bases de datos que consume la API
MONGODB_DATABASE_FOURSQUARE="nombre_bd_foursquare"
MONGODB_DATABASE_GOOGLE="nombre_bd_google"

# Redis. Para ejecutar uvicorn en tu máquina usa localhost; dentro de Docker
# Compose el docker-compose.yml lo sobreescribe a redis://redis:6379.
REDIS_URL="redis://localhost:6379"

# Orígenes permitidos por CORS, en formato lista JSON
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'
