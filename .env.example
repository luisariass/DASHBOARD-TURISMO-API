# =====================
# BACKEND CONFIGURATION (NestJS)
# =====================
PROJECT_NAME="Dashboard Turismo API"
PORT=8000

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE_FOURSQUARE="foursquare_scraping"
MONGODB_DATABASE_GOOGLE="Googlemaps_Scraping"

# Nombres de colección (opcionales, tienen valores por defecto)
# FOURSQUARE_COLLECTION_CLEAN="sities_clean"
# FOURSQUARE_COLLECTION_FULL="sities_full"
# GOOGLE_COLLECTION_CLEAN="sities"
# GOOGLE_COLLECTION_FULL="sities_full"

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# Redis Caché
REDIS_URL="redis://localhost:6379"
CACHE_ENABLED=true

# Servidores DNS personalizados (opcional, solo si Node no resuelve SRV en Windows)
# DNS_SERVERS=8.8.8.8,1.1.1.1

